<!-- snippets/gothic-intro.liquid -->
<div id="rwnd-gothic-intro" class="fixed inset-0 z-[100] flex flex-col items-center justify-between bg-[#060606] text-[#E9E3D5] font-mono-tech select-none transition-all duration-1000 ease-in-out">
  
  <!-- Bulletproof Cinematic Video Background -->
  <video autoplay loop muted playsinline class="absolute inset-0 h-full w-full object-cover opacity-60 mix-blend-screen pointer-events-none">
    <!-- Replace this URL with your final $10K 3D Rendered MP4 -->
    <source src="https://cdn.pixabay.com/video/2020/05/24/40090-424840854_large.mp4" type="video/mp4">
  </video>

  <!-- Atmospheric Vignette -->
  <div class="absolute inset-0 pointer-events-none bg-gradient-to-t from-black via-black/20 to-black/80 z-10"></div>

  <!-- Top Bar -->
  <div class="relative z-20 w-full flex items-center justify-between px-6 py-6">
    <div class="flex items-center gap-3">
      <span class="inline-block h-2 w-2 rounded-full bg-red-600 animate-pulse"></span>
      <span class="text-[10px] tracking-widest uppercase font-bold text-white/70">RWND20S.SYS</span>
    </div>
    <button id="rwnd-skip-intro" type="button" class="rounded-full border border-white/20 bg-black/40 backdrop-blur-md px-4 py-2 text-[10px] font-bold tracking-wider uppercase hover:border-white transition cursor-pointer">
      SKIP →
    </button>
  </div>

  <!-- Center Hero -->
  <div class="relative z-20 flex flex-col items-center text-center px-4 mb-20 scale-100 transition-transform duration-1000" id="rwnd-intro-center">
    <p class="text-[9px] tracking-[0.5em] uppercase text-zinc-400 mb-4">ATMOSPHERIC SUB-ROUTINE LOADED</p>
    <h1 class="font-display text-4xl md:text-6xl font-bold tracking-tighter uppercase text-white drop-shadow-[0_0_25px_rgba(255,255,255,0.2)]">
      NEGATIVE<br>ENERGY
    </h1>
    
    <button id="rwnd-ignite-btn" type="button" class="mt-10 group relative inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/5 backdrop-blur-md px-8 py-4 text-[11px] font-bold tracking-widest text-white uppercase transition-all active:scale-95 hover:bg-white hover:text-black cursor-pointer">
      <span>INITIALIZE DESCENT</span>
    </button>
  </div>

  <!-- Bottom Ticker -->
  <div class="relative z-20 w-full px-6 py-4 border-t border-white/10 bg-black/60 backdrop-blur-md flex items-center justify-between text-[9px] text-zinc-400 tracking-widest uppercase">
    <span>LAT: 9.9252° N (MDU)</span>
    <span>STATUS: SECURE</span>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const introOverlay = document.getElementById('rwnd-gothic-intro');
  const igniteBtn = document.getElementById('rwnd-ignite-btn');
  const skipBtn = document.getElementById('rwnd-skip-intro');
  const centerContent = document.getElementById('rwnd-intro-center');

  if (sessionStorage.getItem('rwnd_gothic_intro_played') === 'true') {
    if (introOverlay) introOverlay.remove();
    return;
  }

  function dismissIntro() {
    sessionStorage.setItem('rwnd_gothic_intro_played', 'true');
    // Cinematic Zoom-In Fade Out
    if (centerContent) centerContent.style.transform = 'scale(1.5)';
    introOverlay.style.opacity = '0';
    introOverlay.style.pointerEvents = 'none';
    
    setTimeout(() => {
      introOverlay.remove();
    }, 1000);
  }

  igniteBtn?.addEventListener('click', dismissIntro);
  skipBtn?.addEventListener('click', dismissIntro);
});
</script>
