<!-- snippets/gothic-intro.liquid -->
<div id="rwnd-gothic-intro" class="fixed inset-0 z-[100] flex flex-col items-center justify-between bg-[#060606] text-[#E9E3D5] overflow-hidden font-mono-tech select-none transition-opacity duration-700">
  
  <!-- Three.js Canvas Container -->
  <div id="webgl-container" class="absolute inset-0 z-0"></div>

  <!-- Atmospheric Vignette & Scanlines -->
  <div class="absolute inset-0 pointer-events-none retro-scanlines z-10 bg-gradient-to-t from-black via-transparent to-black opacity-80"></div>

  <!-- Top Bar: Brand & Audio Control -->
  <div class="relative z-20 w-full flex items-center justify-between px-6 py-6 md:px-12">
    <div class="flex items-center gap-3">
      <span class="inline-block h-2 w-2 rounded-full bg-red-600 animate-pulse"></span>
      <span class="text-xs tracking-widest uppercase font-bold">RWND20S.SYS // GOTHIC_ENGINE v2.6</span>
    </div>
    
    <div class="flex items-center gap-4">
      <button id="rwnd-audio-toggle" type="button" class="rounded-full border border-white/20 bg-black/40 px-4 py-2 text-[11px] font-bold tracking-wider uppercase hover:border-white transition cursor-pointer">
        [ AUDIO: OFF ]
      </button>
      <button id="rwnd-skip-intro" type="button" class="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-[11px] font-bold tracking-wider uppercase hover:bg-white hover:text-black transition cursor-pointer">
        SKIP INTRO →
      </button>
    </div>
  </div>

  <!-- Center Hero Prompt (Triggers Camera Swirl Flight) -->
  <div class="relative z-20 flex flex-col items-center text-center px-4 mb-16">
    <p class="text-[10px] tracking-[0.4em] uppercase text-zinc-400 mb-3">ATMOSPHERIC SUB-ROUTINE LOADED</p>
    <h1 class="font-display text-3xl md:text-6xl font-bold tracking-tight uppercase text-white drop-shadow-[0_0_25px_rgba(220,38,38,0.4)]">
      ENTER THE NEGATIVE ENERGY
    </h1>
    <p class="mt-2 text-xs md:text-sm text-zinc-400 max-w-md">
      Midnight asphalt, towering gothic monoliths, and the blood-red lunar horizon.
    </p>

    <button id="rwnd-ignite-btn" type="button" class="mt-8 group relative inline-flex items-center gap-3 rounded-full border border-white bg-white px-8 py-4 text-xs font-bold tracking-widest text-black uppercase transition-transform active:scale-95 hover:bg-zinc-200 cursor-pointer shadow-[0_0_30px_rgba(255,255,255,0.3)]">
      <span>INITIALIZE DESCENT</span>
      <span class="transition-transform group-hover:translate-x-1">↓</span>
    </button>
  </div>

  <!-- Bottom Ticker Status -->
  <div class="relative z-20 w-full px-6 py-4 border-t border-white/10 bg-black/60 backdrop-blur-md flex items-center justify-between text-[10px] text-zinc-400 tracking-wider">
    <span>LAT: 9.9252° N (MADURAI DISPATCH HUB)</span>
    <span class="hidden md:inline">RENDER: THREE.JS WEBGL + GSAP KINEMATICS</span>
    <span>STATUS: READY FOR DESCENT</span>
  </div>

  <!-- Hidden Ambient Audio Stream -->
  <audio id="rwnd-ambient-audio" loop preload="auto">
    <source src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf756.mp3?filename=dark-ambient-trailer-110457.mp3" type="audio/mpeg">
  </audio>
</div>

<!-- Load Three.js & GSAP via CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const introOverlay = document.getElementById('rwnd-gothic-intro');
  const igniteBtn = document.getElementById('rwnd-ignite-btn');
  const skipBtn = document.getElementById('rwnd-skip-intro');
  const audioBtn = document.getElementById('rwnd-audio-toggle');
  const ambientAudio = document.getElementById('rwnd-ambient-audio');

  // Check session storage
  if (sessionStorage.getItem('rwnd_gothic_intro_played') === 'true') {
    if (introOverlay) introOverlay.remove();
    return;
  }

  const container = document.getElementById('webgl-container');
  if (!container) return;

  // --- THREE.JS OPTIMIZED SCENE SETUP ---
  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x060606, 0.035);

  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.set(0, 15, 45);

  // Performance tuning: limit pixel ratio to 1.5 max for mobile smoothness
  const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
  renderer.outputEncoding = THREE.sRGBEncoding;
  container.appendChild(renderer.domElement);

  // Lighting
  const ambientLight = new THREE.AmbientLight(0x111118, 1.2);
  scene.add(ambientLight);

  const moonLight = new THREE.DirectionalLight(0xff4444, 2.5);
  moonLight.position.set(0, 50, -100);
  scene.add(moonLight);

  // Blood-Red & Silver Moon
  const moonGeo = new THREE.SphereGeometry(14, 24, 24);
  const moonMat = new THREE.MeshBasicMaterial({ color: 0xe9e3d5 });
  const moonMesh = new THREE.Mesh(moonGeo, moonMat);
  moonMesh.position.set(0, 35, -120);
  scene.add(moonMesh);

  const glowGeo = new THREE.RingGeometry(14.5, 18, 24);
  const glowMat = new THREE.MeshBasicMaterial({ color: 0x991b1b, side: THREE.DoubleSide, transparent: true, opacity: 0.6 });
  const glowMesh = new Mesh(glowGeo, glowMat);
  glowMesh.position.copy(moonMesh.position);
  scene.add(glowMesh);

  // Asphalt & Gothic Architecture
  const roadGeo = new THREE.PlaneGeometry(30, 400);
  const roadMat = new THREE.MeshStandardMaterial({ color: 0x0a0a0c, roughness: 0.8, metalness: 0.2 });
  const road = new THREE.Mesh(roadGeo, roadMat);
  road.rotation.x = -Math.PI / 2;
  road.position.set(0, 0, -150);
  scene.add(road);

  const buildingMat = new THREE.MeshStandardMaterial({ color: 0x0d0d12, roughness: 0.9 });
  for (let i = 0; i < 20; i++) { // Optimized count for mobile rendering
    const height = 30 + Math.random() * 40;
    const width = 12 + Math.random() * 8;
    const buildingGeo = new THREE.BoxGeometry(width, height, 15);
    
    const bLeft = new THREE.Mesh(buildingGeo, buildingMat);
    bLeft.position.set(-22 - width / 2, height / 2, -i * 20);
    scene.add(bLeft);

    const bRight = new THREE.Mesh(buildingGeo, buildingMat);
    bRight.position.set(22 + width / 2, height / 2, -i * 20);
    scene.add(bRight);
  }

  // Render loop
  let clock = new THREE.Clock();
  function animate() {
    requestAnimationFrame(animate);
    moonMesh.rotation.y = clock.getElapsedTime() * 0.05;
    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });

  // Audio Handler
  let isAudioPlaying = false;
  audioBtn?.addEventListener('click', () => {
    isAudioPlaying = !isAudioPlaying;
    if (isAudioPlaying) {
      ambientAudio.play().catch(() => {});
      audioBtn.textContent = '[ AUDIO: ON ♫ ]';
      audioBtn.classList.add('border-white', 'bg-white/20');
    } else {
      ambientAudio.pause();
      audioBtn.textContent = '[ AUDIO: OFF ]';
      audioBtn.classList.remove('border-white', 'bg-white/20');
    }
  });

  // Complete Handoff & Descent
  function dismissIntro() {
    sessionStorage.setItem('rwnd_gothic_intro_played', 'true');
    introOverlay.style.opacity = '0';
    setTimeout(() => {
      introOverlay.remove();
      renderer.dispose();
    }, 700);
  }

  function triggerDescent() {
    if (isAudioPlaying) ambientAudio.play().catch(() => {});

    const tl = gsap.timeline({
      onComplete: dismissIntro
    });

    tl.to(camera.rotation, { y: Math.PI * 2, duration: 1.6, ease: "power2.inOut" })
      .to(camera.position, { x: 0, y: 2.2, z: 12, duration: 1.4, ease: "power3.in" }, "-=0.5")
      .to(camera.rotation, { x: 0.05, y: 0, z: 0, duration: 1.0, ease: "power2.out" }, "-=1.0");
  }

  igniteBtn?.addEventListener('click', triggerDescent);
  skipBtn?.addEventListener('click', dismissIntro);
});
</script>
