<!-- sections/footer.liquid -->
<section id="about" class="border-t border-white/10 bg-[#060606] text-white">
  <!-- Brand Manifesto & Spec Grid -->
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="overflow-hidden rounded-3xl border border-white/15 bg-[#0F0F0F] shadow-2xl">
      <div class="flex items-center justify-between border-b border-white/10 px-5 py-3 bg-white/[0.02]">
        <span class="font-mono-tech text-[11px] font-bold tracking-widest text-white uppercase">
          [ RWND20S.SYS // BRAND MANIFESTO ]
        </span>
        <span class="font-mono-tech text-[10px] font-semibold text-zinc-400 uppercase">
          OBSIDIAN BLACK · METALLIC CHROME EDITION
        </span>
      </div>

      <div class="grid grid-cols-1 gap-8 p-6 sm:p-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <p class="font-mono-tech text-xs font-bold tracking-widest text-zinc-400 uppercase">
            04 · ENGINEERED FOR THE MILLENNIUM REWIND
          </p>
          <h2 class="mt-2 font-display text-2xl font-extrabold tracking-tight text-white uppercase sm:text-4xl">
            HEAVY METAL HARDWARE. ZERO FAST-FASHION TRINKETS.
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-zinc-400">
            Born from an obsession with late-90s and early-2000s industrial object design, <strong class="text-white">rwnd20s.</strong> builds heavy 316L stainless steel signet rings, pendant chains, link bracelets, pink chrome Type-C wired earphones, and analog-digital chronographs.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-3.5 lg:col-span-5">
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 backdrop-blur-md">
            <span class="font-mono-tech text-xl font-bold text-white">316L</span>
            <p class="mt-1 text-xs text-zinc-400">Surgical-Grade Stainless Steel</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 backdrop-blur-md">
            <span class="font-mono-tech text-xl font-bold text-white">TYPE-C</span>
            <p class="mt-1 text-xs text-zinc-400">Pink Chrome Wired Earphones + Case</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 backdrop-blur-md">
            <span class="font-mono-tech text-xl font-bold text-white">SAVE ₹248</span>
            <p class="mt-1 text-xs text-zinc-400">3-Piece Y2K Cyber Set Bundle</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 backdrop-blur-md">
            <span class="font-mono-tech text-xl font-bold text-white">₹999+</span>
            <p class="mt-1 text-xs text-zinc-400">Free Express Shipping Across India</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer Columns -->
  <footer class="border-t border-white/10 bg-[#060606]">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <span class="font-display text-2xl font-extrabold tracking-tighter text-white">
            {{ settings.brand_name | default: 'rwnd20s.' }}
          </span>
          <p class="mt-3 max-w-sm text-xs leading-relaxed text-zinc-400">
            Heavy 316L stainless steel hardware, pink chrome Type-C wired earphones, and analog-digital chronographs crafted in limited numbered batches.
          </p>
          <div class="mt-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 font-mono-tech text-[11px] font-bold text-white backdrop-blur-md">
            <span>HQ &amp; DISPATCH: {{ section.settings.dispatch_city | upcase }}</span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:col-span-7">
          <div>
            <h3 class="font-mono-tech text-xs font-bold tracking-wider text-white uppercase">DROP 01 HARDWARE</h3>
            <ul class="mt-3 space-y-2 text-xs text-zinc-400">
              <li><a href="#shop" class="transition-colors hover:text-white">3-Piece Y2K Cyber Set</a></li>
              <li><a href="#shop" class="transition-colors hover:text-white">Pink Chrome Wired Earphones</a></li>
              <li><a href="#shop" class="transition-colors hover:text-white">Cyber Signet Ring</a></li>
              <li><a href="#shop" class="transition-colors hover:text-white">Heavy Chain + Pendant</a></li>
              <li><a href="#shop" class="transition-colors hover:text-white">Chain Bracelet</a></li>
            </ul>
          </div>

          <div>
            <h3 class="font-mono-tech text-xs font-bold tracking-wider text-white uppercase">ARCHIVE LEDGER</h3>
            <ul class="mt-3 space-y-2 text-xs text-zinc-400">
              <li><a href="#about" class="transition-colors hover:text-white">316L Steel Guarantee</a></li>
              <li><a href="#shop" class="transition-colors hover:text-white">48-Hour Unboxing Policy</a></li>
              <li><a href="#shop" class="transition-colors hover:text-white">Type-C Audio Spec</a></li>
            </ul>
          </div>

          <div>
            <h3 class="font-mono-tech text-xs font-bold tracking-wider text-white uppercase">STUDIO &amp; DISPATCH</h3>
            <ul class="mt-3 space-y-2 text-xs text-zinc-400">
              <li class="font-semibold text-white">{{ section.settings.dispatch_city }}</li>
              <li>Free Shipping Above ₹999</li>
              <li>Cash on Delivery (₹0 Advance)</li>
              <li>24–48h Express Pan-India Dispatch</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 text-xs text-zinc-500 sm:flex-row">
        <p>© {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: 'rwnd20s.' }} All rights reserved.</p>
        <p class="font-mono-tech text-[11px] font-semibold text-zinc-300 uppercase">
          METALLIC CHROME HARDWARE ARCHIVE · {{ section.settings.dispatch_city | upcase }}
        </p>
      </div>
    </div>

    <!-- Clean Obsidian Status Bar -->
    <div class="border-t border-white/10 bg-[#040404] py-3 font-mono-tech text-[11px] text-zinc-400">
      <div class="mx-auto flex max-w-7xl flex-col justify-between gap-2 px-4 sm:flex-row sm:items-center sm:px-6 lg:px-8">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-white uppercase tracking-wider">SYSTEM SECURE // NODE: MADURAI_TN</span>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-[10px] tracking-widest uppercase text-zinc-400">
          <span>SERVER: <strong class="text-white">ONLINE (200 OK)</strong></span>
          <span class="text-white">DISPATCH HUB: {{ section.settings.dispatch_city | upcase }}</span>
        </div>
      </div>
    </div>
  </footer>
</section>

{% schema %}
{
  "name": "Footer & Retro Terminal",
  "settings": [
    {
      "type": "text",
      "id": "dispatch_city",
      "label": "Dispatch Studio City",
      "default": "Madurai, Tamil Nadu"
    }
  ],
  "presets": [
    {
      "name": "Footer & Retro Terminal"
    }
  ]
}
{% endschema %}
